# JayShree Caters - Environment Variables Configuration
# Copy this file to .env.local for local overrides

# Application Port (Default: 3000)
PORT=3000

# WhatsApp Primary Coordination Number (Default: 919626426046)
NEXT_PUBLIC_WHATSAPP_NUMBER=919626426046

# Optional Meta WhatsApp Cloud API credentials (if automated webhook delivery is enabled)
WHATSAPP_API_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Business Metadata (Matches centralized site configuration)
NEXT_PUBLIC_COMPANY_NAME="JayShree Caters"
NEXT_PUBLIC_COMPANY_PHONE="+91 98401 23456"
NEXT_PUBLIC_COMPANY_EMAIL="enquiry@jayshreecaters.com"
